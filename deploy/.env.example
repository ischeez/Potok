DOMAIN=korotkov.click
POSTGRES_USER=potok
POSTGRES_DB=potok
# Generate a URL-safe value: openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_a_long_random_hex_value
POTOK_AUTH_USER=owner
# Generate interactively: docker run --rm -it caddy:2-alpine caddy hash-password
# Single quotes preserve the dollar signs in a bcrypt hash in a Compose env file.
POTOK_AUTH_HASH='replace_with_a_caddy_password_hash'

